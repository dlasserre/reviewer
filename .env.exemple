# Copier en `.env` — qui n'est PAS versionne — et remplir.
#
# Il n'y a aucun trousseau dans un conteneur : les references du profil doivent
# etre de la forme `env:NOM`, et c'est ici que les valeurs arrivent.

# Lecture de la forge. Requis.
PAT_READ=

# Ecriture sur la forge. VIDE = l'agent corrige dans son worktree, sans pousser,
# sans ouvrir de PR et sans repondre aux fils. C'est un bon premier cran.
PAT_WRITE=

# Le SDK. Requis. La consommation s'impute sur l'abonnement Claude.
CLAUDE_CODE_OAUTH_TOKEN=

# Ou sont vos depots sur l'hote. Ils seront montes sous /repos dans le
# conteneur — et ce sont les chemins DU CONTENEUR qui vont dans le profil.
REPOS=./repos
